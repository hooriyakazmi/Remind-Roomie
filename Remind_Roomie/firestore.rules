rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function invitationPath(householdId, invitationId) {
      return /databases/$(database)/documents/households/$(householdId)/invitations/$(invitationId);
    }

    function removalPath(uid, householdId) {
      return /databases/$(database)/documents/users/$(uid)/householdRemovals/$(householdId);
    }

    // Check current membership, never membership proposed by a pending write.
    function isMember(householdId) {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.householdId == householdId;
    }

    function isHouseholdHead(householdId) {
      return isMember(householdId)
        && get(householdPath(householdId)).data.createdBy == request.auth.uid;
    }

    function validMessage(data) {
      return data.keys().hasOnly(['senderId', 'text', 'createdAt'])
        && data.senderId == request.auth.uid
        && data.createdAt == request.time
        && data.text is string
        && data.text.size() <= 1000
        && data.text.matches('(?s).*\\S.*');
    }

    function chatMemberMatches(householdId, ids, index) {
      return index >= ids.size()
        || (ids[index] is string && get(profilePath(ids[index])).data.householdId == householdId);
    }

    function validChatMembers(householdId, ids) {
      return ids is list && ids.size() <= 10 && ids.toSet().size() == ids.size()
        && request.auth.uid in ids
        && chatMemberMatches(householdId, ids, 0) && chatMemberMatches(householdId, ids, 1)
        && chatMemberMatches(householdId, ids, 2) && chatMemberMatches(householdId, ids, 3)
        && chatMemberMatches(householdId, ids, 4) && chatMemberMatches(householdId, ids, 5)
        && chatMemberMatches(householdId, ids, 6) && chatMemberMatches(householdId, ids, 7)
        && chatMemberMatches(householdId, ids, 8) && chatMemberMatches(householdId, ids, 9);
    }

    function validChat(householdId, chatId, data) {
      let ids = data.memberIds;
      return data.createdBy == request.auth.uid && data.createdAt == request.time
        && validChatMembers(householdId, ids)
        && (
          (data.type == 'direct' && ids.size() == 2
            && data.keys().hasOnly(['type', 'memberIds', 'createdBy', 'createdAt'])
            && ids[0] < ids[1]
            && chatId == 'dm_' + string(ids[0].size()) + '_' + ids[0] + ids[1])
          || (data.type == 'group' && ids.size() >= 3
            && data.keys().hasOnly(['type', 'memberIds', 'name', 'createdBy', 'createdAt'])
            && !chatId.matches('dm_.*')
            && data.name is string && data.name.size() <= 60 && data.name.matches('(?s).*\\S.*'))
        );
    }

    function profileHasRequiredFields(data) {
      return data.keys().hasAll(['email', 'displayName', 'householdId'])
        && data.keys().hasOnly(['email', 'displayName', 'householdId', 'invitationId', 'color', 'previousNames'])
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.displayName.size() > 0
        && (data.householdId == null || data.householdId is string)
        && data.get('previousNames', []) is list
        && (data.get('color', null) == null || (data.color is string && data.color.size() == 7));
    }

    // History may only be preserved or extended with this user's own old name.
    function validNameHistory() {
      let before = resource.data.get('previousNames', []);
      let after = request.resource.data.get('previousNames', []);
      return after == before
        || (request.resource.data.displayName != resource.data.displayName
          && after == before.concat([resource.data.displayName]));
    }

    // The household must be NEW and created in this same atomic batch.
    function canCreateHousehold(householdId) {
      return householdId is string
        && householdId.size() > 0
        && resource.data.householdId == null
        && !exists(householdPath(householdId))
        && getAfter(householdPath(householdId)).data.createdBy == request.auth.uid
        && request.resource.data.get('invitationId', null) == resource.data.get('invitationId', null);
    }

    // Both sides of an invitation redemption must change together. A previously
    // accepted invitation is insufficient, even if it names this same user.
    function canJoinInvitedHousehold(householdId) {
      let invitationId = request.resource.data.get('invitationId', '');
      let path = invitationPath(householdId, invitationId);
      return householdId is string
        && householdId.size() > 0
        && resource.data.householdId == null
        && invitationId is string
        && invitationId.size() > 0
        && exists(householdPath(householdId))
        && get(path).data.householdId == householdId
        && get(path).data.email == request.auth.token.email
        && get(path).data.status == 'pending'
        && invitationIsNewEnough(householdId, get(path).data.get('createdAt', null))
        && getAfter(path).data.status == 'accepted'
        && getAfter(path).data.acceptedBy == request.auth.uid
        && getAfter(path).data.acceptedAt == request.time;
    }

    function invitationIsNewEnough(householdId, createdAt) {
      let path = removalPath(request.auth.uid, householdId);
      return !exists(path) || createdAt > get(path).data.removedAt;
    }

    function canRemoveMember(uid, householdId) {
      return signedIn() && uid != request.auth.uid
        && householdId is string && isHouseholdHead(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId', 'invitationId'])
        && request.resource.data.householdId == null
        && request.resource.data.get('invitationId', null) == null
        && getAfter(removalPath(uid, householdId)).data.removedAt == request.time;
    }

    match /users/{uid} {
      // Signup/profile recovery cannot grant household membership.
      allow create: if signedIn()
        && request.auth.uid == uid
        && profileHasRequiredFields(request.resource.data)
        && request.resource.data.householdId == null
        && !request.resource.data.keys().hasAny(['invitationId'])
        && request.resource.data.get('previousNames', []) == [];

      // Supports the app's where('householdId', '==', householdId) query.
      allow get, list: if signedIn()
        && (request.auth.uid == uid
          || (resource.data.householdId != null && isMember(resource.data.householdId)));

      allow update: if signedIn()
        && request.auth.uid == uid
        && profileHasRequiredFields(request.resource.data)
        && validNameHistory()
        && (
          (request.resource.data.householdId == resource.data.householdId
            && request.resource.data.get('invitationId', null) == resource.data.get('invitationId', null))
          || canCreateHousehold(request.resource.data.householdId)
          || canJoinInvitedHousehold(request.resource.data.householdId)
        );

      allow update: if canRemoveMember(uid, resource.data.householdId);

      allow delete: if false;

      match /householdRemovals/{householdId} {
        allow create, update: if signedIn() && uid != request.auth.uid
          && isHouseholdHead(householdId)
          && get(profilePath(uid)).data.householdId == householdId
          && getAfter(profilePath(uid)).data.householdId == null
          && request.resource.data.keys().hasOnly(['removedAt'])
          && request.resource.data.removedAt == request.time;
      }

      match /imports/{householdId} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(householdId);
        allow create: if signedIn() && request.auth.uid == uid && isMember(householdId)
          && request.resource.data.keys().hasOnly(['importedAt'])
          && request.resource.data.importedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /households/{householdId} {
      // Mirrors createHousehold(): create the household and update an existing,
      // unassigned user profile in one batch. Neither write may succeed alone.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.householdId == null
        && getAfter(profilePath(request.auth.uid)).data.householdId == householdId;
      allow get: if isMember(householdId);
      allow list, update, delete: if false;

      // Tasks are collaborative: current household members retain all of the
      // app's request, rescheduling, completion, and legacy import operations.
      match /tasks/{taskId} {
        allow read, write: if isMember(householdId);
      }

      match /notificationInboxes/{recipientId}/items/{notificationId} {
        function matchesLegacyAssignee(task) {
          let profile = get(profilePath(request.auth.uid)).data;
          let assigned = task.get('assignedTo', '');
          let names = assigned is list ? assigned : assigned.split('\\s*,\\s*');
          return names.hasAny([request.auth.uid, profile.displayName, 'Household'].concat(profile.get('previousNames', [])));
        }

        function matchesAssigner(task) {
          let id = task.get('assignedById', null);
          let name = task.get('assignedBy', '');
          return id != null ? id == recipientId
            : name == recipientId || matchesLegacyAssigner(name);
        }

        function matchesLegacyAssigner(name) {
          let profile = get(profilePath(recipientId)).data;
          return profile.householdId == householdId
            && (profile.displayName == name || name in profile.get('previousNames', []));
        }

        function validCompletionNotice(notice) {
          let path = /databases/$(database)/documents/households/$(householdId)/tasks/$(notice.taskId);
          let before = get(path).data;
          let after = getAfter(path).data;
          let members = before.get('memberIds', []);
          return before.status == 'accepted' && before.get('completed', false) != true
            && (members is list && members.size() > 0 ? request.auth.uid in members : matchesLegacyAssignee(before))
            && matchesAssigner(before)
            && after.status == 'completed' && after.completed == true
            && after.completionNoticeId == notificationId
            && notice.title == before.title;
        }

        allow read: if isMember(householdId) && request.auth.uid == recipientId;
        allow create: if isMember(householdId) && request.auth.uid != recipientId
          && request.resource.data.keys().hasOnly(['taskId', 'title', 'senderId', 'createdAt', 'read'])
          && request.resource.data.taskId is string
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false
          && validCompletionNotice(request.resource.data);
        allow update: if isMember(householdId) && request.auth.uid == recipientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(householdId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(householdId)
          && resource.data.createdBy == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && validMessage(request.resource.data);
        allow update, delete: if false;
      }

      match /chats/{chatId} {
        allow read: if isMember(householdId) && request.auth.uid in resource.data.memberIds;
        allow create: if signedIn() && validChat(householdId, chatId, request.resource.data);
        allow update, delete: if false;

        match /messages/{messageId} {
          function canAccessChat() {
            return isMember(householdId) && request.auth.uid in
              get(/databases/$(database)/documents/households/$(householdId)/chats/$(chatId)).data.memberIds;
          }
          allow read: if canAccessChat();
          allow create: if canAccessChat() && validMessage(request.resource.data);
          allow update, delete: if false;
        }
      }

      match /invitations/{invitationId} {
        allow create: if isMember(householdId)
          && request.resource.data.keys().hasAll(['householdId', 'email', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasOnly(['householdId', 'email', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.status == 'pending';

        allow get: if isMember(householdId)
          || (signedIn() && resource.data.email == request.auth.token.email);
        allow list: if isMember(householdId);

        // Freeze recipient, household, creator, and creation metadata; require
        // the invitee's previously unassigned profile to join in this batch.
        allow update: if signedIn()
          && exists(householdPath(householdId))
          && resource.data.householdId == householdId
          && resource.data.status == 'pending'
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && exists(profilePath(request.auth.uid))
          && get(profilePath(request.auth.uid)).data.householdId == null
          && getAfter(profilePath(request.auth.uid)).data.householdId == householdId
          && getAfter(profilePath(request.auth.uid)).data.invitationId == invitationId;

        allow delete: if isMember(householdId);
      }
    }
  }
}
